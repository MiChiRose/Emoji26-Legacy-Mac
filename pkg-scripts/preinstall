#!/bin/sh
set -eu

DEST="/Library/Fonts/Emoji26 Additions.ttf"
STATE="/Library/Application Support/EmojiLegacyPatch"
TARGET_OS="__TARGET_OS__"

[ "`uname -m`" = x86_64 ] || {
  echo "Emoji26 Additions requires Intel x86_64." >&2
  exit 1
}

VERSION=`sw_vers -productVersion`
[ "$VERSION" = "$TARGET_OS" ] || {
  echo "This package targets OS X $TARGET_OS; found $VERSION." >&2
  exit 1
}

FREE_KB=`df -k /Library | awk 'NR==2 {print $4}'`
case "$FREE_KB" in
  ''|*[!0-9]*)
    echo "Could not determine free space on /Library." >&2
    exit 1
    ;;
esac
[ "$FREE_KB" -ge 524288 ] || {
  echo "At least 512 MB of free space is required for install and rollback." >&2
  exit 1
}

STAMP=`date +%Y%m%d-%H%M%S`
BACKUP="$STATE/backups/$STAMP"
mkdir -p "$BACKUP"

if [ -f "$DEST" ]; then
  {
    echo "previous=present"
    echo "path=$DEST"
    shasum -a 256 "$DEST"
    stat -f 'owner=%Su group=%Sg mode=%Lp bytes=%z' "$DEST"
  } > "$BACKUP/metadata.txt"
  cp -p "$DEST" "$BACKUP/Emoji26 Additions.ttf"
else
  {
    echo "previous=absent"
    echo "path=$DEST"
  } > "$BACKUP/metadata.txt"
fi

echo "$STAMP" > "$STATE/pending-backup"
exit 0
